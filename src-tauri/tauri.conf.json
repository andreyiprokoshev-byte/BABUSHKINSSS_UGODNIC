{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pirozhkovy Dvor 3D",
  "identifier": "io.github.andreyiprokoshev-byte.pirozhkovy-dvor",
  "build": {
    "beforeBuildCommand": "bun run build",
    "beforeDevCommand": "bun run vite --host 127.0.0.1 --port 3000 --strictPort",
    "devUrl": "http://127.0.0.1:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Пирожковый Двор 3D",
        "width": 1240,
        "height": 780,
        "minWidth": 800,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "publisher": "andreyiprokoshev-byte",
    "category": "Game",
    "linux": { "deb": { "depends": ["libc6 (>= 2.39)"] } },
    "shortDescription": "Пирожковый Двор 3D"
  }
}
